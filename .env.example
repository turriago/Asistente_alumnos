# Copia este archivo a .env y ajusta valores locales.
# No subas .env a Git.

DEMO_MODE=true
ATTENDANCE_CONFIG=config/default.yaml
LOG_LEVEL=INFO

# CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
FACE_SCORE_THRESHOLD=0.7
FACE_MATCH_THRESHOLD=0.45
# FACE_MATCH_INTERVAL_MS=120
# HANDS_MAX_NUM=2
# HANDS_MIN_DETECTION=0.5
# HANDS_DETECT_INTERVAL_MS=0
# HANDS_NUMBER_STABLE_MS=250
KIOSK_HOST=127.0.0.1
KIOSK_PORT=8080

# Supabase (fotos y vídeos en Storage; en Postgres solo id/nombre/url).
# Crea el proyecto, corre supabase/schema.sql y pega las claves.
# La service_role NO va al celular ni a GitHub.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
